# Copy this file to .env and fill in your values.
# Do NOT commit .env — it contains your access token.

# ws:// for HTTP, wss:// for HTTPS. Same host you browse HA with,
# with /api/websocket appended. Include the port if non-default.
HA_WS_URL=wss://your-ha-host.example/api/websocket

# Long-lived access token: HA profile -> Security -> Long-lived access tokens
HA_TOKEN=your_long_lived_access_token

# Entity-ID prefix of managed containers (underscore form, e.g. ix_ not ix-).
# Optional; default: ix_
#HA_PREFIX=ix_

# Comma-separated entity-ID substrings to KEEP (not disabled).
# Optional; empty/omitted = all prefixed entities are disabled.
# Example:
#HA_KEEP=out_of_memory,health

# WebSocket timeout values in positive whole seconds.
# Optional; defaults: 10 seconds to connect, 30 seconds per response.
# Increase these if Home Assistant is slow or reached over a high-latency link.
#HA_CONNECT_TIMEOUT_S=10
#HA_RESPONSE_TIMEOUT_S=30